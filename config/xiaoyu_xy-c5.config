#
# XiaoYu XY-C5（ramips / mt7621）—— 精简固件配置
#
# 设计原则
#   1. 只声明「目标设备 + 必需增量」，其余交给 `make defconfig` 按上游该机型的默认值补全，
#      使产物包集合 = 官方可启动镜像的默认集 + 本文件的少量增量。
#   2. 绝不强制加入下列两项（旧配置里有，官方镜像里完全没有，是本次重建重点规避的差异）：
#        - uboot-envtools：会带入 /etc/board.d/05_fw_defaults 与 /etc/uci-defaults/30_uboot-envtools，
#          被 /lib/preinit/82_config_generate 在 preinit 极早期执行 fw_loadenv 去读 U-Boot 环境变量；
#          经 Breed 刷入的设备其 U-Boot env 布局与原生 U-Boot 不一致，属于官方镜像中不存在的早期启动分支。
#        - opkg：上游 main 已全面改用 apk，强制装 opkg 会与 apk-mbedtls 并存并引入 20_migrate-feeds 迁移钩子。
#   3. IPv6 与 mt7621 硬件加速均保留：上游默认包集合本身已含
#      odhcp6c、odhcpd-ipv6only、kmod-nft-offload、kmod-nf-flow，此处再加 6in4/6rd/6to4 隧道支持。
#   4. ipv6helper 包在新版上游已被移除，写了也只会被 defconfig 丢弃，故不再声明。
#

# ---------- 目标平台与设备（唯一必需项）----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaoyu_xy-c5=y

# ---------- 网页管理（精简但完整可用）----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---------- IPv6 隧道辅助（odhcp6c / odhcpd-ipv6only 已由上游默认带入）----------
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_6to4=y

# ---------- mt7621 硬件加速 / 流量卸载（上游默认已含，此处显式声明意图）----------
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# ---------- 显式排除（禁令，防止被回填）----------
# CONFIG_PACKAGE_uboot-envtools is not set
# CONFIG_PACKAGE_opkg is not set
