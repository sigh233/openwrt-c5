#
# 最小化 OpenWrt 构建配置文件
# 目标: XiaoYu XY-C5 (MT7621)
# 参考: Hyy2001X/AutoBuild-Actions-BETA/Configs/xiaoyu_xy-c5
#
# 需求: 最新版 OpenWrt + IPv6 + 硬件加速
# 插件: 全部移除（只保留核心 LuCI + turboacc 硬件 offload）
#

#==== 目标系统 ===========================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaoyu_xy-c5=y
CONFIG_TARGET_IMAGES_PAD=y
CONFIG_TARGET_IMAGES_GZIP=y

#==== IPv6 ================================================================
# 启用 IPv6 内核支持
CONFIG_IPV6=y
CONFIG_KERNEL_IPV6=y
# IPv6 辅助工具
CONFIG_PACKAGE_ipv6helper=y
# dnsmasq 完整功能 (支持 DHCPv6)
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
# 隧道协议支持
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_6to4=y

#==== 硬件 offload =======================================================
# 硬件流卸载 (MT7621 PPE / MT7530 Switch)
# 需要 firewall4 配合使用 (默认已包含)
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y

#==== TurboACC ============================================================
# 流量加速 (仅 offload + BBR, 不含其他插件)
# INCLUDE_OFFLOADING 启用硬件 offload 功能
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y

#==== 核心 LuCI (仅保留 Web 管理界面) =====================================
# LuCI 主程序及基础库
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-json=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-lib-net=y
CONFIG_PACKAGE_luci-lib-px5g=y
CONFIG_PACKAGE_luci-lib-uci=y
# 网络协议支持
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-netdev=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-socks=y
# 默认主题
CONFIG_PACKAGE_luci-theme-bootstrap=y

#==== 基础系统 ============================================================
# 核心工具链
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libmbedtls=y
CONFIG_PACKAGE_mounts=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_rescue=y
CONFIG_PACKAGE_uboot-envtools=y
# 防火墙
CONFIG_PACKAGE_firewall4=y
# 网络守护
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_ubox=y
